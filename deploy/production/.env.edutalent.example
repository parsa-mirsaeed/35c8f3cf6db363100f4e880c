# Public, non-secret production configuration template.
#
# Copy this file to .env.edutalent, set the domain/CIDR/TLS settings for the
# deployment, then run `bash edutalent production-init` to generate the
# passwords and API keys. Do not replace the placeholder secrets below with
# real values in version control.

APP_DOMAIN=app.example.invalid
SUPABASE_DOMAIN=supabase.example.invalid
ADMIN_DOMAIN=admin.example.invalid
ADMIN_ALLOWED_CIDRS=127.0.0.1/32
TLS_CERT_FILE=/etc/edutalent/tls/fullchain.pem
TLS_KEY_FILE=/etc/edutalent/tls/privkey.pem

DATABASE_APP_USER=edutalent_app
DATABASE_APP_PASSWORD=replace-with-generated-value
DATABASE_MAX_CONNECTIONS=15
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30

QDRANT_API_KEY=replace-with-generated-value
QDRANT_COLLECTION=edutalent_materials_local_v1
QDRANT_VECTOR_SIZE=384

EMBEDDING_PROFILE=local-embedding
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://embedding:80/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384

EDUTALENT_INTERNAL_PORT=8080
SERVER_WORKERS=2
RUST_LOG=info
LOG_LEVEL=info
LOG_FORMAT=json
JWT_EXPIRATION_HOURS=24
SUPABASE_AUDIENCE=authenticated
