#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUPABASE_DIR="${SCRIPT_DIR}/runtime/supabase"
SUPABASE_ENV="${SUPABASE_DIR}/.env"
APP_ENV="${SCRIPT_DIR}/.env.edutalent"
APP_TEMPLATE="${SCRIPT_DIR}/.env.edutalent.example"
OVERLAY="${SCRIPT_DIR}/compose.production.yaml"

usage() {
  cat <<'USAGE'
EduTalent production appliance command

Usage: edutalent-production <command> [arguments]

Commands:
  bootstrap            Fetch the exact pinned official Supabase Docker runtime
  init                 Generate fresh production secrets after domains are set
  validate             Verify secrets, TLS, rendered Compose, and exposure rules
  config               Render the complete effective production Compose config
  up                   Start the self-hosted production stack
  down                 Stop the stack without deleting data
  ps                   Show service status
  logs [services...]   Follow logs (defaults to gateway, app, auth, db, qdrant)
  migrate              Re-run EduTalent migrations against Supabase PostgreSQL
  database-check       Verify the running app uses the constrained backend role
  gateway-check        Verify non-root, capability-free TLS gateway state
  qdrant-check         Verify private Qdrant readiness from the app container
  help                 Show this help
USAGE
}

require_runtime() {
  [[ -f "${SUPABASE_DIR}/docker-compose.yml" ]] || {
    echo "Supabase runtime is missing. Run: $0 bootstrap" >&2
    exit 1
  }
}

require_envs() {
  require_runtime
  [[ -f "${SUPABASE_ENV}" && -f "${APP_ENV}" ]] || {
    echo "Production environments are missing. Run: $0 init" >&2
    exit 1
  }
}

read_env() {
  local file="$1" key="$2"
  awk -F= -v key="${key}" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "${file}"
}

compose() {
  require_envs
  export EDUTALENT_PRODUCTION_DIR="${SCRIPT_DIR}"
  local -a profile_args=()
  local profile
  profile="$(read_env "${APP_ENV}" EMBEDDING_PROFILE)"
  case "${profile}" in
    "") ;;
    local-embedding) profile_args=(--profile local-embedding) ;;
    *) echo "Unsupported EMBEDDING_PROFILE=${profile}" >&2; exit 1 ;;
  esac

  docker compose \
    --project-name edutalent \
    --project-directory "${SUPABASE_DIR}" \
    --env-file "${SUPABASE_ENV}" \
    --env-file "${APP_ENV}" \
    -f "${SUPABASE_DIR}/docker-compose.yml" \
    -f "${OVERLAY}" \
    "${profile_args[@]}" \
    "$@"
}

# Remove only one-shot containers that have already completed successfully.
# Failed containers remain available for operator inspection, and a still-running
# initializer is never stopped by cleanup. Running this after failure prevents
# successful bootstrap URLs and host TLS bind paths from lingering in stopped
# container metadata when an unrelated long-running service fails to start.
cleanup_completed_one_shots() {
  local service container_id inspection state exit_code
  for service in migrate database-access gateway-tls; do
    container_id="$(compose ps --all --quiet "${service}" 2>/dev/null || true)"
    [[ -n "${container_id}" ]] || continue

    inspection="$(
      docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' \
        "${container_id}" 2>/dev/null || true
    )"
    read -r state exit_code <<<"${inspection}"
    if [[ "${state:-}" == "exited" && "${exit_code:-}" == "0" ]]; then
      compose rm --force "${service}" >/dev/null
    fi
  done
}

startup_diagnostics() {
  echo "Production startup failed; service state follows." >&2
  compose ps --all >&2 || true
  echo "Bounded migration/database/auth/gateway logs follow." >&2
  compose logs --no-color --tail 300 \
    migrate database-access db auth kong app gateway-tls gateway functions >&2 || true
  echo "Bounded pooler logs follow; credential-shaped values are redacted." >&2
  compose logs --no-color --tail 100 supavisor 2>&1 | sed -E \
    -e 's#(postgres(ql)?://)[^[:space:]]+#\1[REDACTED]#gI' \
    -e 's#(Authorization:|apikey:|Bearer)[[:space:]]+[^[:space:]]+#\1 [REDACTED]#gI' \
    -e 's#[[:alnum:]_~-]{32,}#[REDACTED]#g' >&2 || true
}

command="${1:-help}"
shift || true

case "${command}" in
  bootstrap)
    exec bash "${SCRIPT_DIR}/bootstrap-supabase.sh" "$@"
    ;;
  init)
    require_runtime
    if [[ ! -f "${APP_ENV}" ]]; then
      cp "${APP_TEMPLATE}" "${APP_ENV}"
      chmod 600 "${APP_ENV}"
      echo "Created ${APP_ENV}. Set APP_DOMAIN, SUPABASE_DOMAIN, ADMIN_DOMAIN, ADMIN_ALLOWED_CIDRS, and absolute TLS paths, then run init again."
      exit 0
    fi
    exec bash "${SCRIPT_DIR}/generate-secrets.sh"
    ;;
  validate)
    exec bash "${SCRIPT_DIR}/preflight.sh"
    ;;
  config)
    compose config
    ;;
  up)
    bash "${SCRIPT_DIR}/preflight.sh"
    if ! compose up --detach --wait; then
      startup_diagnostics
      cleanup_completed_one_shots
      exit 1
    fi
    cleanup_completed_one_shots
    ;;
  down)
    compose down --remove-orphans
    ;;
  ps)
    compose ps
    ;;
  logs)
    if (($# == 0)); then
      set -- gateway app auth db qdrant
    fi
    compose logs --follow "$@"
    ;;
  migrate)
    compose run --rm migrate
    compose run --rm --no-deps database-access
    ;;
  database-check)
    compose exec -T app bash -eu -o pipefail -c '
      # PostgreSQL boolean values explicitly cast to text are "true"/"false".
      role_row="$(psql "${DATABASE_URL}" --tuples-only --no-align --field-separator="|" --command="
        SELECT current_user,
               rolsuper::text,
               rolinherit::text,
               rolcreatedb::text,
               rolcreaterole::text,
               rolreplication::text,
               rolbypassrls::text
        FROM pg_roles
        WHERE rolname = current_user
      ")"
      IFS="|" read -r role super inherit createdb createrole replication bypassrls <<<"${role_row}"
      [ "${role}" = "${DATABASE_APP_USER}" ]
      [ "${super}" = "false" ]
      [ "${inherit}" = "false" ]
      [ "${createdb}" = "false" ]
      [ "${createrole}" = "false" ]
      [ "${replication}" = "false" ]
      [ "${bypassrls}" = "true" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_database_privilege(current_user, current_database(), '"'"'CONNECT'"'"')")" = "t" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_schema_privilege(current_user, '"'"'public'"'"', '"'"'USAGE'"'"')")" = "t" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_schema_privilege(current_user, '"'"'public'"'"', '"'"'CREATE'"'"')")" = "f" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_table_privilege(current_user, '"'"'public.users'"'"', '"'"'SELECT'"'"')")" = "t" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT NOT (
        has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'INSERT'"'"') OR
        has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'UPDATE'"'"') OR
        has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'DELETE'"'"')
      )")" = "t" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT NOT (
        has_table_privilege(current_user, '"'"'public._sqlx_migrations'"'"', '"'"'INSERT'"'"') OR
        has_table_privilege(current_user, '"'"'public._sqlx_migrations'"'"', '"'"'UPDATE'"'"') OR
        has_table_privilege(current_user, '"'"'public._sqlx_migrations'"'"', '"'"'DELETE'"'"')
      )")" = "t" ]
      echo "Dedicated non-superuser EduTalent database role verified."
    '
    ;;
  gateway-check)
    http_binding="$(compose port gateway 8080)"
    https_binding="$(compose port gateway 8443)"
    [[ "${http_binding}" == "0.0.0.0:80" ]] || {
      echo "Gateway HTTP port is not published as 0.0.0.0:80 (got ${http_binding:-none})." >&2
      exit 1
    }
    [[ "${https_binding}" == "0.0.0.0:443" ]] || {
      echo "Gateway HTTPS port is not published as 0.0.0.0:443 (got ${https_binding:-none})." >&2
      exit 1
    }
    compose exec -T gateway sh -eu -s <<'SH'
      key=/etc/caddy/tls/privkey.pem
      cert=/etc/caddy/tls/fullchain.pem
      uid="$(id -u)"
      gid="$(id -g)"
      [ "${uid}" -ne 0 ]
      [ -r "${key}" ]
      [ -r "${cert}" ]
      [ "$(stat -c %a "${key}")" = "600" ]
      [ "$(stat -c %u "${key}")" = "${uid}" ]
      [ "$(stat -c %g "${key}")" = "${gid}" ]
      for directory in /data /config; do
        [ -d "${directory}" ]
        [ -w "${directory}" ]
        [ "$(stat -c %a "${directory}")" = "700" ]
        [ "$(stat -c %u "${directory}")" = "${uid}" ]
        [ "$(stat -c %g "${directory}")" = "${gid}" ]
      done
      cap_eff="$(awk '/^CapEff:/ { print $2 }' /proc/self/status)"
      [ "${cap_eff}" = "0000000000000000" ]
      echo "Non-root capability-free gateway TLS and persistent state verified."
SH
    echo "Gateway host bindings 80/443 verified."
    ;;
  qdrant-check)
    compose exec -T app sh -eu -c '
      attempt=1
      while [ "${attempt}" -le 30 ]; do
        if curl --fail --silent --show-error \
          --header "api-key: ${QDRANT_API_KEY}" \
          http://qdrant:6333/readyz >/dev/null 2>&1; then
          echo "Private Qdrant readiness verified."
          exit 0
        fi
        attempt=$((attempt + 1))
        sleep 2
      done
      echo "Private Qdrant did not become ready." >&2
      exit 1
    '
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
