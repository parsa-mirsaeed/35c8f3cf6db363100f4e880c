# EduTalent Mode 2: local/private app + Qdrant + local embeddings, no local LLM
EDUTALENT_IMAGE=edutalent:mode2
APP_PORT=10000
APP_ENV=production

# Current application database/auth backend.
# Mode 2 localizes vectors and embeddings. Supabase Auth/Postgres remains required by current code.
DATABASE_URL=postgresql://postgres:postgres@your-db-host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
JWT_SECRET=replace-with-a-long-random-secret

# Local embedding server.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_DELAY_SECONDS=0
EMBEDDING_HTTP_PORT=8080

# Private Qdrant.
QDRANT_VECTOR_SIZE=384
QDRANT_COLLECTION_NAME=materials
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Mode 2 has no local LLM and should not call hosted LLM APIs.
LLM_PROVIDER=disabled
# Do not set DEEPSEEK_API_KEY for this mode.
