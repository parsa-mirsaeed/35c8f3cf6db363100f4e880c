#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../../scripts/appliance/release_manifest.py" ]]; then
  ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
else
  ROOT_DIR="${SCRIPT_DIR}"
fi
MANIFEST="${ROOT_DIR}/manifests/release-manifest.json"
CHECKSUMS="${ROOT_DIR}/SHA256SUMS"
PRODUCTION_DIR="${ROOT_DIR}/deploy/production"
MODEL_DIR="${ROOT_DIR}/models/local-bge-v1"
LOCKED_COMPOSE="${ROOT_DIR}/manifests/compose.locked.yaml"

usage() {
  cat <<'USAGE'
EduTalent air-gapped appliance

Usage: edutalent-appliance <command> [arguments]

Commands:
  verify                 Verify manifest, checksums, signatures, and release policy
  load                   Load every packaged OCI/Docker image without registry access
  init                   Generate fresh installation secrets using the packaged tools image
  start                  Start the complete appliance with pull policy disabled
  stop                   Stop the appliance without deleting data
  status                 Show appliance service status
  checks                 Run database, gateway, AI outage/recovery, and Qdrant checks
  install <directory>    Copy the verified appliance to a new empty destination
  help                   Show this help
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Required command not found: $1" >&2
    exit 1
  }
}

manifest_value() {
  local expression="$1"
  python3 - "${MANIFEST}" "${expression}" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
value = manifest
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PY
}

host_platform() {
  local machine
  machine="$(uname -m)"
  case "${machine}" in
    x86_64|amd64) echo linux/amd64 ;;
    aarch64|arm64) echo linux/arm64 ;;
    *) echo "Unsupported host architecture: ${machine}" >&2; return 1 ;;
  esac
}

verify_signatures() {
  local public_key="${ROOT_DIR}/signatures/verification.pub"
  local manifest_signature="${ROOT_DIR}/signatures/release-manifest.sig"
  local checksums_signature="${ROOT_DIR}/signatures/SHA256SUMS.sig"
  local manifest_bundle="${ROOT_DIR}/signatures/release-manifest.sigstore.json"
  local checksums_bundle="${ROOT_DIR}/signatures/SHA256SUMS.sigstore.json"
  local signing_mode
  signing_mode="$(manifest_value release.signing_mode)"

  require_command cosign
  case "${signing_mode}" in
    ephemeral)
      [[ -f "${public_key}" && -f "${manifest_signature}" && -f "${checksums_signature}" ]] || {
        echo "Complete ephemeral release signature material is missing." >&2
        return 1
      }
      cosign verify-blob \
        --key "${public_key}" \
        --signature "${manifest_signature}" \
        "${MANIFEST}" >/dev/null
      cosign verify-blob \
        --key "${public_key}" \
        --signature "${checksums_signature}" \
        "${CHECKSUMS}" >/dev/null
      echo "Verified ephemeral validation signatures with the packaged public key."
      ;;
    keyless)
      [[ -f "${manifest_bundle}" && -f "${checksums_bundle}" ]] || {
        echo "Complete keyless release signature material is missing." >&2
        return 1
      }
      local issuer="${EDUTALENT_APPLIANCE_TRUSTED_OIDC_ISSUER:-}"
      local identity="${EDUTALENT_APPLIANCE_TRUSTED_IDENTITY_REGEXP:-}"
      [[ -n "${issuer}" && -n "${identity}" ]] || {
        echo "Keyless verification requires independently supplied EDUTALENT_APPLIANCE_TRUSTED_OIDC_ISSUER and EDUTALENT_APPLIANCE_TRUSTED_IDENTITY_REGEXP." >&2
        return 1
      }
      cosign verify-blob \
        --bundle "${manifest_bundle}" \
        --certificate-oidc-issuer "${issuer}" \
        --certificate-identity-regexp "${identity}" \
        "${MANIFEST}" >/dev/null
      cosign verify-blob \
        --bundle "${checksums_bundle}" \
        --certificate-oidc-issuer "${issuer}" \
        --certificate-identity-regexp "${identity}" \
        "${CHECKSUMS}" >/dev/null
      echo "Verified keyless release signatures against the independently supplied trust policy."
      ;;
    *)
      echo "Unsupported signed release mode: ${signing_mode}" >&2
      return 1
      ;;
  esac
}

verify_bundle() {
  require_command python3
  [[ -f "${MANIFEST}" && -f "${CHECKSUMS}" ]] || {
    echo "Release manifest or checksum set is missing." >&2
    exit 1
  }
  python3 "${ROOT_DIR}/scripts/appliance/release_manifest.py" verify --bundle "${ROOT_DIR}"
  verify_signatures
  local expected actual
  expected="$(manifest_value release.platform)"
  actual="$(host_platform)"
  [[ "${expected}" == "${actual}" ]] || {
    echo "Appliance platform ${expected} does not match host ${actual}." >&2
    exit 1
  }
}

image_rows() {
  python3 - "${MANIFEST}" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
for image in manifest["images"]:
    print(f"{image['archive']}\t{image['local_tag']}\t{image['image_id']}")
PY
}

tools_image() {
  python3 - "${MANIFEST}" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
for image in manifest["images"]:
    if image["component"] == "appliance-tools":
        print(image["local_tag"])
        raise SystemExit(0)
raise SystemExit("appliance-tools image is missing from the manifest")
PY
}

all_images_loaded() {
  require_command docker
  local observed
  while IFS=$'\t' read -r _archive tag expected_id; do
    observed="$(docker image inspect --format '{{.Id}}' "${tag}" 2>/dev/null || true)"
    [[ "${observed}" == "${expected_id}" ]] || return 1
  done < <(image_rows)
}

load_images() {
  verify_bundle
  require_command docker
  require_command gzip
  local observed
  while IFS=$'\t' read -r archive tag expected_id; do
    echo "Loading ${tag}"
    gzip -dc "${ROOT_DIR}/${archive}" | docker load >/dev/null
    observed="$(docker image inspect --format '{{.Id}}' "${tag}")"
    [[ "${observed}" == "${expected_id}" ]] || {
      echo "Loaded image identity mismatch for ${tag}: ${observed}" >&2
      exit 1
    }
  done < <(image_rows)
  echo "All appliance images loaded without registry access."
}

ensure_images_loaded() {
  verify_bundle
  if all_images_loaded; then
    echo "All manifest-owned appliance images are already loaded."
  else
    load_images
  fi
}

production() {
  local command="$1"
  shift
  export EDUTALENT_COMPOSE_OVERRIDE="${LOCKED_COMPOSE}"
  export EDUTALENT_APPLIANCE_MODEL_DIR="${MODEL_DIR}"
  exec bash "${PRODUCTION_DIR}/edutalent-production" "${command}" "$@"
}

init_secrets() {
  verify_bundle
  [[ -d "${PRODUCTION_DIR}/runtime/supabase" ]] || {
    echo "Packaged Supabase runtime is missing." >&2
    exit 1
  }
  if [[ ! -f "${PRODUCTION_DIR}/.env.edutalent" ]]; then
    cp "${PRODUCTION_DIR}/.env.edutalent.example" "${PRODUCTION_DIR}/.env.edutalent"
    chmod 600 "${PRODUCTION_DIR}/.env.edutalent"
    echo "Created ${PRODUCTION_DIR}/.env.edutalent."
    echo "Set domains, administrative CIDRs, and absolute TLS paths, then rerun init."
    return 0
  fi
  ensure_images_loaded
  local tools
  tools="$(tools_image)"
  docker run --rm --network none \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -v "${ROOT_DIR}:/appliance" \
    -w /appliance/deploy/production \
    "${tools}" ./generate-secrets.sh
}

install_bundle() {
  local destination="${1:-}"
  [[ -n "${destination}" ]] || { echo "install requires a destination directory" >&2; exit 2; }
  verify_bundle
  require_command tar
  mkdir -p "${destination}"
  destination="$(cd "${destination}" && pwd)"
  [[ "${destination}" != "${ROOT_DIR}" ]] || { echo "destination is the current bundle" >&2; exit 2; }
  if find "${destination}" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    echo "install destination must be empty: ${destination}" >&2
    exit 1
  fi
  (cd "${ROOT_DIR}" && tar --exclude='./deploy/production/.env.edutalent' --exclude='./deploy/production/runtime/supabase/.env' -cf - .) \
    | (cd "${destination}" && tar -xf -)
  chmod 0755 "${destination}/edutalent-appliance"
  bash "${destination}/edutalent-appliance" verify
  echo "Installed and verified appliance at ${destination}"
}

command="${1:-help}"
shift || true
case "${command}" in
  verify) verify_bundle ;;
  load) load_images ;;
  init) init_secrets ;;
  start)
    ensure_images_loaded
    production up "$@"
    ;;
  stop) production down "$@" ;;
  status) production ps "$@" ;;
  checks)
    export EDUTALENT_COMPOSE_OVERRIDE="${LOCKED_COMPOSE}"
    export EDUTALENT_APPLIANCE_MODEL_DIR="${MODEL_DIR}"
    bash "${PRODUCTION_DIR}/edutalent-production" database-check
    bash "${PRODUCTION_DIR}/edutalent-production" gateway-check
    bash "${PRODUCTION_DIR}/edutalent-production" ai-check
    bash "${PRODUCTION_DIR}/edutalent-production" qdrant-check
    ;;
  install) install_bundle "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: ${command}" >&2; usage >&2; exit 2 ;;
esac
