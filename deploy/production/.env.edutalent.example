# Public, non-secret production configuration template.
#
# Copy this file to .env.edutalent, set the domain/CIDR/TLS settings for the
# deployment, then run `bash edutalent production-init` to generate local
# passwords and internal service credentials. Provider keys remain operator-owned
# and must never be committed.

APP_DOMAIN=app.example.invalid
SUPABASE_DOMAIN=supabase.example.invalid
ADMIN_DOMAIN=admin.example.invalid
ADMIN_ALLOWED_CIDRS=127.0.0.1/32
TLS_CERT_FILE=/etc/edutalent/tls/fullchain.pem
TLS_KEY_FILE=/etc/edutalent/tls/privkey.pem

DATABASE_APP_USER=edutalent_app
DATABASE_APP_PASSWORD=replace-with-generated-value
DATABASE_MAX_CONNECTIONS=15
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30

QDRANT_API_KEY=replace-with-generated-value
QDRANT_COLLECTION=edutalent_materials_local_v1
QDRANT_VECTOR_SIZE=384

# The app receives only this internal URL/token. Each AI request carries the
# authoritative school ID from PostgreSQL; no installation-wide tenant fallback
# exists. Provider keys and destinations remain gateway-only.
AI_GATEWAY_URL=http://ai-gateway:8090
AI_GATEWAY_INTERNAL_TOKEN=replace-with-generated-value
AI_GATEWAY_MODE=offline
AI_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
AI_CONNECT_TIMEOUT_SECONDS=5
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=30
AI_EMBEDDING_CONCURRENCY=4
AI_LLM_CONCURRENCY=2
AI_EMBEDDING_QUOTA_REQUESTS_PER_HOUR=2000
AI_EMBEDDING_QUOTA_CHARS_PER_HOUR=5000000
AI_LLM_QUOTA_REQUESTS_PER_HOUR=500
AI_LLM_QUOTA_CHARS_PER_HOUR=2000000
AI_MAX_BODY_BYTES=262144
AI_MAX_PROVIDER_RESPONSE_BYTES=16777216
AI_MAX_EMBEDDING_INPUTS=64
AI_MAX_EMBEDDING_CHARS=120000
AI_MAX_CHAT_MESSAGES=24
AI_MAX_PROMPT_CHARS=80000
AI_MAX_OUTPUT_TOKENS=4096
AI_GATEWAY_CPU_LIMIT=1.00
AI_GATEWAY_MEMORY_LIMIT=1G

# Default offline profile. Connected mode must switch all four profile values
# together to openai-v1/text-embedding-3-small/1536/edutalent_openai_v1 and set
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1/.
EMBEDDING_PROFILE=local-bge-v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_EMBEDDING_BASE_URL=http://embedding:80/v1/

# Exact connected-mode credentials. Keys are intentionally empty in version
# control and are required only when AI_GATEWAY_MODE=connected.
OPENAI_API_KEY=
AI_LLM_BASE_URL=https://api.deepseek.com/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

EDUTALENT_INTERNAL_PORT=8080
SERVER_WORKERS=2
RUST_LOG=info
LOG_LEVEL=info
LOG_FORMAT=json
JWT_EXPIRATION_HOURS=24
SUPABASE_AUDIENCE=authenticated
