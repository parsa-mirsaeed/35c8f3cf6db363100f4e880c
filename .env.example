# Local ports
EDUTALENT_PORT=8080
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_PORT=8081
AI_GATEWAY_PORT=8090

# Local PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edutalent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edutalent
DATABASE_MAX_CONNECTIONS=15
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30

# Application server
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=2
RUST_LOG=info
LOG_LEVEL=info
LOG_FORMAT=pretty
JWT_EXPIRATION_HOURS=24

# Supabase authentication/user-management integration.
# Replace these placeholders before testing login or user provisioning.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Qdrant profile. Collections are versioned by embedding model.
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=edutalent_local_bge_v1
QDRANT_VECTOR_SIZE=384

# Internal AI gateway. The development token is non-production and must never be
# copied to a real installation. Provider credentials belong only to ai-gateway.
AI_GATEWAY_URL=http://localhost:8090
AI_GATEWAY_INTERNAL_TOKEN=development-only-ai-gateway-token-0001
AI_GATEWAY_DEFAULT_SCHOOL_ID=00000000-0000-4000-8000-000000000001
AI_GATEWAY_MODE=offline
AI_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
AI_CONNECT_TIMEOUT_SECONDS=5
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=30
AI_EMBEDDING_CONCURRENCY=4
AI_LLM_CONCURRENCY=2
AI_EMBEDDING_QUOTA_REQUESTS_PER_HOUR=2000
AI_LLM_QUOTA_REQUESTS_PER_HOUR=500
AI_MAX_BODY_BYTES=262144
AI_MAX_EMBEDDING_INPUTS=64
AI_MAX_EMBEDDING_CHARS=120000
AI_MAX_PROMPT_CHARS=80000

# Offline embedding profile. The app talks to ai-gateway, never TEI directly.
EMBEDDING_PROFILE=local-bge-v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_EMBEDDING_BASE_URL=http://embedding:80/v1/
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# Connected mode provider configuration. Leave keys empty in source-controlled
# templates. Exact allowlists are owned by the gateway, not application requests.
AI_ALLOWED_EMBEDDING_BASE_URLS=https://api.openai.com/v1/
OPENAI_API_KEY=
AI_LLM_BASE_URL=https://api.deepseek.com/v1/
AI_ALLOWED_LLM_BASE_URLS=https://api.deepseek.com/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Durable knowledge worker
KNOWLEDGE_JOB_POLL_MS=1000
KNOWLEDGE_JOB_HEARTBEAT_SECONDS=15
KNOWLEDGE_JOB_STALE_SECONDS=120
KNOWLEDGE_JOB_MAX_ATTEMPTS=5
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200

# Packaging
EDUTALENT_IMAGE=edutalent
IMAGE_REPOSITORY=
