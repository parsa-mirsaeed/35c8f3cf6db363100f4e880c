#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUPABASE_DIR="${SCRIPT_DIR}/runtime/supabase"
SUPABASE_ENV="${EDUTALENT_SUPABASE_ENV:-${SUPABASE_DIR}/.env}"
APP_ENV="${EDUTALENT_APP_ENV:-${SCRIPT_DIR}/.env.edutalent}"
APP_TEMPLATE="${SCRIPT_DIR}/.env.edutalent.example"
OVERLAY="${SCRIPT_DIR}/compose.production.yaml"

usage() {
  cat <<'USAGE'
EduTalent production appliance command

Usage: edutalent-production <command> [arguments]

Commands:
  bootstrap            Fetch the exact pinned official Supabase Docker runtime
  init                 Generate fresh local production secrets
  validate             Verify secrets, TLS, topology, profiles, and egress rules
  config               Render the complete effective production Compose config
  up                   Start the self-hosted production stack
  down                 Stop the stack without deleting data
  ps                   Show service status
  logs [services...]   Follow logs (defaults to gateway, app, ai-gateway, auth, db)
  migrate              Re-run migrations and backend-role configuration
  database-check       Verify the constrained backend database role
  gateway-check        Verify Caddy/TLS and denied public Auth operations
  ai-check             Verify AI isolation, authentication, outage, and recovery
  qdrant-check         Verify private authenticated Qdrant readiness
  help                 Show this help
USAGE
}

require_runtime() {
  [[ -f "${SUPABASE_DIR}/docker-compose.yml" ]] || {
    echo "Supabase runtime is missing. Run: $0 bootstrap" >&2
    exit 1
  }
}

require_envs() {
  require_runtime
  [[ -f "${SUPABASE_ENV}" && -f "${APP_ENV}" ]] || {
    echo "Production environments are missing. Run: $0 init" >&2
    exit 1
  }
}

read_env() {
  local file="$1" key="$2"
  awk -F= -v key="${key}" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "${file}"
}

compose() {
  require_envs
  export EDUTALENT_PRODUCTION_DIR="${SCRIPT_DIR}"
  local -a profile_args=()
  local profile
  profile="$(read_env "${APP_ENV}" EMBEDDING_PROFILE)"
  case "${profile}" in
    local-bge-v1) profile_args=(--profile local-embedding) ;;
    openai-v1) ;;
    *) echo "Unsupported EMBEDDING_PROFILE=${profile}" >&2; exit 1 ;;
  esac

  docker compose \
    --project-name edutalent \
    --project-directory "${SUPABASE_DIR}" \
    --env-file "${SUPABASE_ENV}" \
    --env-file "${APP_ENV}" \
    -f "${SUPABASE_DIR}/docker-compose.yml" \
    -f "${OVERLAY}" \
    "${profile_args[@]}" \
    "$@"
}

cleanup_completed_one_shots() {
  local service container_id inspection state exit_code
  for service in migrate database-access gateway-tls; do
    container_id="$(compose ps --all --quiet "${service}" 2>/dev/null || true)"
    [[ -n "${container_id}" ]] || continue
    inspection="$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "${container_id}" 2>/dev/null || true)"
    read -r state exit_code <<<"${inspection}"
    if [[ "${state:-}" == "exited" && "${exit_code:-}" == "0" ]]; then
      compose rm --force "${service}" >/dev/null
    fi
  done
}

startup_diagnostics() {
  echo "Production startup failed; service state follows." >&2
  compose ps --all >&2 || true
  echo "Bounded migration/database/auth/gateway logs follow." >&2
  compose logs --no-color --tail 300 \
    migrate database-access db auth kong app ai-gateway gateway-tls gateway functions >&2 || true
  echo "Bounded pooler logs follow; credential-shaped values are redacted." >&2
  compose logs --no-color --tail 100 supavisor 2>&1 | sed -E \
    -e 's#(postgres(ql)?://)[^[:space:]]+#\1[REDACTED]#gI' \
    -e 's#(Authorization:|apikey:|Bearer)[[:space:]]+[^[:space:]]+#\1 [REDACTED]#gI' \
    -e 's#[[:alnum:]_~-]{32,}#[REDACTED]#g' >&2 || true
}

verify_public_auth_denials() {
  local supabase_domain publishable_key probe_email probe_password payload
  local temp_dir signup_response signup_status admin_response admin_status
  supabase_domain="$(read_env "${APP_ENV}" SUPABASE_DOMAIN)"
  publishable_key="$(read_env "${SUPABASE_ENV}" SUPABASE_PUBLISHABLE_KEY)"
  [[ -n "${supabase_domain}" && -n "${publishable_key}" ]] || return 1
  command -v curl >/dev/null 2>&1
  command -v python3 >/dev/null 2>&1
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "${temp_dir}"' RETURN
  signup_response="${temp_dir}/signup.json"
  admin_response="${temp_dir}/admin.json"
  probe_email="public-auth-probe@${supabase_domain}"
  probe_password='Ci-PublicAuthDenied-Aa1!'
  payload="$(printf '{"email":"%s","password":"%s"}' "${probe_email}" "${probe_password}")"

  signup_status="$(curl --silent --show-error --insecure \
    --output "${signup_response}" --write-out '%{http_code}' --noproxy '*' \
    --resolve "${supabase_domain}:443:127.0.0.1" \
    -H "apikey: ${publishable_key}" -H 'Content-Type: application/json' \
    --data "${payload}" "https://${supabase_domain}/auth/v1/signup")"
  [[ "${signup_status}" == "422" ]] || {
    echo "Public signup returned ${signup_status}, expected 422." >&2
    return 1
  }
  python3 - "${signup_response}" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
assert body.get("error_code") == "signup_disabled", body
assert "access_token" not in body and "user" not in body, body
PY
  echo "Public email signup denial verified."

  admin_status="$(curl --silent --show-error --insecure \
    --output "${admin_response}" --write-out '%{http_code}' --noproxy '*' \
    --resolve "${supabase_domain}:443:127.0.0.1" \
    -H "apikey: ${publishable_key}" \
    "https://${supabase_domain}/auth/v1/admin/users?per_page=1")"
  [[ "${admin_status}" == "403" ]] || {
    echo "Publishable-key admin request returned ${admin_status}, expected 403." >&2
    return 1
  }
  python3 - "${admin_response}" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
assert body.get("error_code") == "not_admin", body
assert "users" not in body and "access_token" not in body and "user" not in body, body
PY
  echo "Publishable credential administrative denial verified."
}

verify_ai_network_membership() {
  local service container_id networks
  for service in ai-gateway app db qdrant auth kong; do
    container_id="$(compose ps --quiet "${service}")"
    [[ -n "${container_id}" ]] || { echo "Missing running ${service} container." >&2; return 1; }
    networks="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}' "${container_id}")"
    case "${service}" in
      ai-gateway)
        [[ " ${networks} " == *" edutalent-ai-internal "* && " ${networks} " == *" edutalent-ai-egress "* ]] || {
          echo "AI gateway network membership is incomplete: ${networks}" >&2
          return 1
        }
        ;;
      app)
        [[ " ${networks} " == *" edutalent-ai-internal "* ]] || { echo "App is missing internal AI network." >&2; return 1; }
        [[ " ${networks} " != *" edutalent-ai-egress "* ]] || { echo "App received AI egress network." >&2; return 1; }
        ;;
      *)
        [[ " ${networks} " != *" edutalent-ai-egress "* ]] || { echo "${service} received AI egress network." >&2; return 1; }
        ;;
    esac
  done
  echo "Exclusive AI egress network membership verified."
}

command="${1:-help}"
shift || true
case "${command}" in
  bootstrap) exec bash "${SCRIPT_DIR}/bootstrap-supabase.sh" "$@" ;;
  init)
    require_runtime
    if [[ ! -f "${APP_ENV}" ]]; then
      cp "${APP_TEMPLATE}" "${APP_ENV}"
      chmod 600 "${APP_ENV}"
      echo "Created ${APP_ENV}. Set domains, admin CIDRs, and absolute TLS paths, then run init again."
      exit 0
    fi
    exec bash "${SCRIPT_DIR}/generate-secrets.sh"
    ;;
  validate) exec bash "${SCRIPT_DIR}/preflight.sh" ;;
  config) compose config ;;
  up)
    bash "${SCRIPT_DIR}/preflight.sh"
    if ! compose up --detach --wait; then
      startup_diagnostics
      cleanup_completed_one_shots
      exit 1
    fi
    cleanup_completed_one_shots
    ;;
  down) compose down --remove-orphans ;;
  ps) compose ps ;;
  logs)
    if (($# == 0)); then set -- gateway app ai-gateway auth db qdrant; fi
    compose logs --follow "$@"
    ;;
  migrate)
    compose run --rm migrate
    compose run --rm --no-deps database-access
    ;;
  database-check)
    compose exec -T app bash -eu -o pipefail -c '
      role_row="$(psql "${DATABASE_URL}" --tuples-only --no-align --field-separator="|" --command="
        SELECT current_user, rolsuper::text, rolinherit::text, rolcreatedb::text,
               rolcreaterole::text, rolreplication::text, rolbypassrls::text
        FROM pg_roles WHERE rolname = current_user")"
      IFS="|" read -r role super inherit createdb createrole replication bypassrls <<<"${role_row}"
      [ "${role}" = "${DATABASE_APP_USER}" ]
      [ "${super}" = "false" ]
      [ "${inherit}" = "false" ]
      [ "${createdb}" = "false" ]
      [ "${createrole}" = "false" ]
      [ "${replication}" = "false" ]
      [ "${bypassrls}" = "false" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_schema_privilege(current_user, '"'"'public'"'"', '"'"'CREATE'"'"')")" = "f" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT has_table_privilege(current_user, '"'"'public.users'"'"', '"'"'SELECT'"'"')")" = "t" ]
      [ "$(psql "${DATABASE_URL}" -Atc "SELECT NOT (has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'INSERT'"'"') OR has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'UPDATE'"'"') OR has_table_privilege(current_user, '"'"'public.edutalent_migration_files'"'"', '"'"'DELETE'"'"'))")" = "t" ]
      echo "Dedicated NOBYPASSRLS non-superuser EduTalent database role verified."
    '
    ;;
  gateway-check)
    [[ "$(compose port gateway 8080)" == "0.0.0.0:80" ]]
    [[ "$(compose port gateway 8443)" == "0.0.0.0:443" ]]
    compose exec -T gateway sh -eu -s <<'SH'
      key=/etc/caddy/tls/privkey.pem
      cert=/etc/caddy/tls/fullchain.pem
      uid="$(id -u)"; gid="$(id -g)"
      [ "${uid}" -ne 0 ] && [ -r "${key}" ] && [ -r "${cert}" ]
      [ "$(stat -c %a "${key}")" = "600" ]
      [ "$(stat -c %u "${key}")" = "${uid}" ]
      [ "$(stat -c %g "${key}")" = "${gid}" ]
      for directory in /data /config; do
        [ -w "${directory}" ] && [ "$(stat -c %a "${directory}")" = "700" ]
        [ "$(stat -c %u "${directory}")" = "${uid}" ]
        [ "$(stat -c %g "${directory}")" = "${gid}" ]
      done
      [ "$(awk '/^CapEff:/ { print $2 }' /proc/self/status)" = "0000000000000000" ]
      echo "Non-root capability-free gateway state verified."
SH
    verify_public_auth_denials
    echo "Gateway host bindings 80/443 verified."
    ;;
  ai-check)
    verify_ai_network_membership
    probe_school_id="$(python3 -c 'import uuid; print(uuid.uuid4())')"
    compose exec -T -e "AI_PROBE_SCHOOL_ID=${probe_school_id}" app sh -eu -c '
      case "${EMBEDDING_PROFILE}" in
        local-bge-v1)
          payload='"'"'{"model":"BAAI/bge-small-en-v1.5","input":["boundary probe"],"dimensions":null}'"'"'
          ;;
        openai-v1)
          payload='"'"'{"model":"text-embedding-3-small","input":["boundary probe"],"dimensions":1536}'"'"'
          ;;
        *) echo "Unsupported embedding profile" >&2; exit 1 ;;
      esac
      curl --fail --silent http://ai-gateway:8090/healthz >/dev/null
      status="$(curl --silent --output /dev/null --write-out "%{http_code}" \
        -H "Authorization: Bearer invalid-token" \
        -H "x-edutalent-school-id: ${AI_PROBE_SCHOOL_ID}" \
        -H "Content-Type: application/json" --data "${payload}" \
        http://ai-gateway:8090/v1/embeddings)"
      [ "${status}" = "401" ]
      status="$(curl --silent --output /dev/null --write-out "%{http_code}" \
        -H "Authorization: Bearer ${AI_GATEWAY_INTERNAL_TOKEN}" \
        -H "Content-Type: application/json" --data "${payload}" \
        http://ai-gateway:8090/v1/embeddings)"
      [ "${status}" = "400" ]
      echo "AI gateway authentication and tenant boundaries verified."
    '

    ai_gateway_stopped=false
    restore_ai_gateway() {
      if [[ "${ai_gateway_stopped}" == true ]]; then
        compose start ai-gateway >/dev/null 2>&1 || true
      fi
    }
    trap restore_ai_gateway EXIT
    compose stop ai-gateway >/dev/null
    ai_gateway_stopped=true
    compose exec -T app curl --fail --silent http://127.0.0.1:8080/healthz >/dev/null
    if compose exec -T app curl --fail --silent --max-time 2 http://ai-gateway:8090/healthz >/dev/null 2>&1; then
      echo "AI gateway remained reachable after it was stopped." >&2
      exit 1
    fi
    echo "Core application remained healthy during complete AI gateway outage."

    compose start ai-gateway >/dev/null
    ai_gateway_stopped=false
    recovered=false
    for attempt in $(seq 1 60); do
      if compose exec -T app curl --fail --silent http://ai-gateway:8090/healthz >/dev/null 2>&1; then
        recovered=true
        break
      fi
      sleep 2
    done
    [[ "${recovered}" == true ]] || { echo "AI gateway did not recover." >&2; exit 1; }
    compose exec -T app curl --fail --silent http://127.0.0.1:8080/healthz >/dev/null
    trap - EXIT
    echo "AI gateway recovery and provider-independent core health verified."
    ;;
  qdrant-check)
    compose exec -T app sh -eu -c '
      attempt=1
      while [ "${attempt}" -le 30 ]; do
        if curl --fail --silent --header "api-key: ${QDRANT_API_KEY}" http://qdrant:6333/readyz >/dev/null 2>&1; then
          echo "Private Qdrant readiness verified."; exit 0
        fi
        attempt=$((attempt + 1)); sleep 2
      done
      echo "Private Qdrant did not become ready." >&2; exit 1
    '
    ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: ${command}" >&2; usage >&2; exit 2 ;;
esac
