# Local ports
EDUTALENT_PORT=8080
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_PORT=8081

# Local PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edutalent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edutalent
DATABASE_MAX_CONNECTIONS=15
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=30

# Application server
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=2
RUST_LOG=info
LOG_LEVEL=info
LOG_FORMAT=pretty
JWT_EXPIRATION_HOURS=24

# Supabase authentication/user-management integration.
# Replace these placeholders before testing login or user provisioning.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Qdrant
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=edutalent_materials
QDRANT_VECTOR_SIZE=384

# OpenAI-compatible embedding endpoint. Docker Compose supplies a local TEI endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VECTOR_SIZE=384
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# Durable knowledge worker
KNOWLEDGE_JOB_POLL_MS=1000
KNOWLEDGE_JOB_HEARTBEAT_SECONDS=15
KNOWLEDGE_JOB_STALE_SECONDS=120
KNOWLEDGE_JOB_MAX_ATTEMPTS=5
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200

# Packaging
EDUTALENT_IMAGE=edutalent
IMAGE_REPOSITORY=
