# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22.17.0-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        gawk \
        grep \
        openssl \
        sed \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
USER node
ENTRYPOINT ["/bin/bash"]
